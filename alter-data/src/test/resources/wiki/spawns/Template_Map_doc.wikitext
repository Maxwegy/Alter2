|id = feat-fillOpacity
}}
{{ArgDocLine
|name = group
|description = Sets the group for a feature. Features on separate map instances will appear on all instances on the same page if the group name is the same. Consider adding a unique group name if a page has a lot of pins.
|values = Any text
|default = <code>pins</code>
|id = feat-group
